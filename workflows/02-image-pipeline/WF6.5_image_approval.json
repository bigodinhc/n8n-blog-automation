    {
      "parameters": {
        "jsCode": "// PREPARAR UPLOAD WP - Preservando Binary Data\n// O binary data vem do node DOWNLOAD IMAGEM SUPABASE\n\nconst postData = $('BUSCAR DADOS PUBLISH').item.json;\nconst imageData = $('BUSCAR IMAGEM APROVADA').item.json;\n\n// Pega o binary data do node de download\nconst downloadItem = $('DOWNLOAD IMAGEM SUPABASE').item;\nconst binaryData = downloadItem.binary;\n\n// Gerar nome de arquivo SEO-friendly\nconst filename = postData.title\n  .toLowerCase()\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[^a-z0-9\\s-]/g, '')\n  .replace(/\\s+/g, '-')\n  .replace(/-+/g, '-')\n  .replace(/^-|-$/g, '')\n  .substring(0, 60) + '.png';\n\n// Retorna JSON + Binary Data preservado\nreturn {\n  json: {\n    filename: filename,\n    title: postData.title,\n    post_id: postData.id,\n    image_record_id: imageData.id,\n    supabase_image_url: imageData.image_url\n  },\n  binary: binaryData  // IMPORTANTE: Preserva o binary data!\n};"
      },
      "id": "preparar-upload-wp",
      "name": "PREPARAR UPLOAD WP",
      "type": "n8n-nodes-base.code",

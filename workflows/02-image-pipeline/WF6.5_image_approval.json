    {
      "parameters": {
        "jsCode": "const postData = $('BUSCAR DADOS PUBLISH').item.json;\nconst imageData = $('BUSCAR IMAGEM APROVADA').item.json;\nconst wpMediaData = $('UPLOAD IMAGEM WP').item.json;\nconst prepUpload = $('PREPARAR UPLOAD WP').item.json;\n\n// Mapeamento de categorias e tags\nconst WP_CATEGORIES = {'Breaking News': 1, 'Iron Ore News': 163, 'Steel News': 175, 'Metals News': 176};\nconst WP_TAGS = {'iron-ore': 165, 'iodex': 166, 'china': 167, 'brazil-miners': 168, 'global-miners': 169, 'freight': 170, 'steel': 171, 'market-analysis': 172, 'price-alert': 173, 'weekly-report': 174};\n\n// Limpar HTML (sem adicionar imagem - vai ser featured_media)\nlet cleanHtml = postData.content_html || '';\ncleanHtml = cleanHtml.replace(/<div class=\"post-metadata\">[\\s\\S]*?<\\/div>/gi, '').trim();\n\n// Determinar categorias\nconst wpCategoryNames = [];\nconst dbCategories = Array.isArray(postData.categories) ? postData.categories : [];\nif (postData.tier === 'TIER_1') wpCategoryNames.push('Breaking News');\ndbCategories.forEach(cat => {\n  const catLower = cat.toLowerCase();\n  if (catLower.includes('china') || catLower.includes('demanda') || catLower.includes('preco') || catLower.includes('spot')) {\n    if (!wpCategoryNames.includes('Iron Ore News')) wpCategoryNames.push('Iron Ore News');\n  }\n  if (catLower.includes('siderur') || catLower.includes('steel') || catLower.includes('aco')) {\n    if (!wpCategoryNames.includes('Steel News')) wpCategoryNames.push('Steel News');\n  }\n});\nif (wpCategoryNames.length === 0) wpCategoryNames.push('Iron Ore News');\nconst wpCategoryIds = wpCategoryNames.map(name => WP_CATEGORIES[name]).filter(id => id);\n\n// Determinar tags\nconst wpTagSlugs = [];\nconst dbTags = Array.isArray(postData.tags) ? postData.tags : [];\ndbTags.forEach(tag => {\n  const tagLower = tag.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n  if (tagLower.includes('minerio') || tagLower.includes('iron')) wpTagSlugs.push('iron-ore');\n  if (tagLower.includes('iodex') || tagLower.includes('platts')) wpTagSlugs.push('iodex');\n  if (tagLower.includes('china')) wpTagSlugs.push('china');\n  if (tagLower.includes('vale') || tagLower.includes('csn')) wpTagSlugs.push('brazil-miners');\n  if (tagLower.includes('bhp') || tagLower.includes('rio')) wpTagSlugs.push('global-miners');\n});\nif (wpTagSlugs.length === 0) wpTagSlugs.push('iron-ore');\nconst wpTagIds = [...new Set(wpTagSlugs)].map(slug => WP_TAGS[slug]).filter(id => id);\n\n// Gerar slug\nconst slug = postData.slug || postData.title.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').substring(0, 50);\n\nreturn {\n  post_id: postData.id,\n  wp_title: postData.title,\n  wp_content: cleanHtml,\n  wp_slug: slug,\n  wp_categories: wpCategoryIds,\n  wp_tags: wpTagIds,\n  wp_category_names: wpCategoryNames,\n  wp_tag_slugs: [...new Set(wpTagSlugs)],\n  featured_media_id: wpMediaData.id,\n  wp_image_url: wpMediaData.source_url || wpMediaData.guid?.rendered,\n  supabase_image_url: imageData.image_url,\n  image_record_id: prepUpload.image_record_id\n};"
      },

          "id": "AImySn34fvezwusy",
          "name": "MT_Newsletter"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Processar callback do Telegram para Newsletter\nconst callback = $input.first().json;\nconst callbackData = callback.callback_query?.data || '';\nconst chatId = callback.callback_query?.message?.chat?.id || '';\nconst messageId = callback.callback_query?.message?.message_id || '';\nconst callbackId = callback.callback_query?.id || '';\n\n// Verificar se eh callback de newsletter\nif (!callbackData.startsWith('nl_')) {\n  return [{ json: { is_newsletter: false, skip: true } }];\n}\n\n// Extrair acao e session_id\nlet action = '';\nlet sessionId = '';\n\n// Formato: nl_action_sessionId\n// O sessionId sempre comeca com \"newsletter_\"\nif (callbackData.includes('_approve_')) {\n  action = 'approve_and_send';\n  // Extrair tudo a partir de \"newsletter_\"\n  const match = callbackData.match(/newsletter_\\d+/);\n  sessionId = match ? match[0] : '';\n} else if (callbackData.includes('_view_image_')) {\n  action = 'view_image';\n  const match = callbackData.match(/newsletter_\\d+/);\n  sessionId = match ? match[0] : '';\n} else if (callbackData.includes('_regen_image_')) {\n  action = 'regen_image';\n  const match = callbackData.match(/newsletter_\\d+/);\n  sessionId = match ? match[0] : '';\n} else if (callbackData.includes('_cancel_')) {\n  action = 'cancel';\n  const match = callbackData.match(/newsletter_\\d+/);\n  sessionId = match ? match[0] : '';\n}\n\nreturn [{\n  json: {\n    is_newsletter: true,\n    action: action,\n    session_id: sessionId,\n    chat_id: String(chatId),\n    message_id: messageId,\n    callback_id: callbackId,\n    callback_data: callbackData\n  }\n}];"
      },

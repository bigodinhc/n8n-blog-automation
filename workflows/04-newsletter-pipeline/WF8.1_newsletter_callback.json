    {
      "parameters": {
        "jsCode": "// Aprovar conteúdo - mostrar botões para imagem e envio\nconst processData = $('PROCESSAR CALLBACK').first().json;\nconst sessionId = processData.session_id;\nconst newsletter = $('BUSCAR NEWSLETTER').first().json;\n\nlet message = `✅ *CONTEÚDO APROVADO*\\n`;\nmessage += `━━━━━━━━━━━━━━━━━━━━━\\n\\n`;\nmessage += `📧 Assunto: ${newsletter.subject}\\n\\n`;\nmessage += `Agora vamos verificar a imagem.\\n`;\nmessage += `Clique em \"Ver Imagem\" para visualizar.\\n\\n`;\nmessage += `Após aprovar a imagem, você poderá enviar a newsletter.`;\n\nconst buttons = {\n  inline_keyboard: [\n    [\n      { text: '🖼 Ver Imagem', callback_data: `nl_view_image_${sessionId}` },\n      { text: '🔄 Nova Imagem', callback_data: `nl_regen_image_${sessionId}` }\n    ],\n    [\n      { text: '❌ Cancelar', callback_data: `nl_cancel_${sessionId}` }\n    ]\n  ]\n};\n\nreturn [{\n  json: {\n    chat_id: processData.chat_id,\n    text: message,\n    parse_mode: 'Markdown',\n    reply_markup: buttons,\n    session_id: sessionId,\n    update_stage: 'pending_image',\n    content_approved: true\n  }\n}];"
      },

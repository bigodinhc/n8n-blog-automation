      "parameters": {
        "jsCode": "// Preparar envio da imagem\nconst processData = $('PROCESSAR CALLBACK').first().json;\nconst newsletter = $('BUSCAR NEWSLETTER').first().json;\nconst sessionId = processData.session_id;\n\nlet message = `🖼 *IMAGEM DA NEWSLETTER*\\n`;\nmessage += `━━━━━━━━━━━━━━━━━━━━━\\n\\n`;\nmessage += `A imagem foi gerada para o header da newsletter.\\n\\n`;\nmessage += `📧 Assunto: ${newsletter.subject}\\n\\n`;\nmessage += `Aprove a imagem para prosseguir com o envio.`;\n\nconst buttons = {\n  inline_keyboard: [\n    [\n      { text: '✅ Aprovar Imagem', callback_data: `nl_approve_image_${sessionId}` },\n      { text: '🔄 Regenerar', callback_data: `nl_regen_image_${sessionId}` }\n    ],\n    [\n      { text: '❌ Cancelar', callback_data: `nl_cancel_${sessionId}` }\n    ]\n  ]\n};\n\nreturn [{\n  json: {\n    chat_id: processData.chat_id,\n    text: message,\n    parse_mode: 'Markdown',\n    reply_markup: buttons,\n    session_id: sessionId,\n    image_url: newsletter.image_url\n  }\n}];"

        "jsCode": "// Preparar lista de destinatários WhatsApp\nconst newsletter = $('BUSCAR NEWSLETTER').first().json;\nconst subscribers = $('BUSCAR SUBSCRIBERS').all().map(s => s.json);\n\n// Filtrar apenas quem tem WhatsApp habilitado\nconst whatsappSubscribers = subscribers.filter(s => {\n  const channels = Array.isArray(s.channels) ? s.channels : JSON.parse(s.channels || '[\"email\"]');\n  return channels.includes('whatsapp') && s.phone;\n});\n\n// Se não há destinatários, retornar item para pular loop\nif (whatsappSubscribers.length === 0) {\n  return [{ \n    json: { \n      newsletter_id: newsletter.id,\n      whatsapp_recipients: 0, \n      skip_whatsapp: true,\n      content_text: newsletter.content_text\n    } \n  }];\n}\n\n// Retornar um item para cada destinatário\nreturn whatsappSubscribers.map(sub => ({\n  json: {\n    newsletter_id: newsletter.id,\n    subscriber_phone: sub.phone,\n    subscriber_name: sub.name,\n    message_text: newsletter.content_text,\n    whatsapp_recipients: whatsappSubscribers.length,\n    skip_whatsapp: false\n  }\n}));"

        "jsCode": "// Preparar mensagem de confirmacao do teste\nconst newsletter = $('BUSCAR NEWSLETTER').first().json;\nconst sessionData = $('BUSCAR SESSAO').first().json;\nconst sendData = $('ENVIAR TODOS').first().json;\n\nlet message = `✅ *NEWSLETTER ENVIADA (TESTE)*\\n`;\nmessage += `━━━━━━━━━━━━━━━━━━━━━\\n\\n`;\nmessage += `📧 *Email enviado para:* ${sendData.test_email}\\n\\n`;\nmessage += `━━━━━━━━━━━━━━━━━━━━━\\n`;\nmessage += `📋 *Assunto:* ${newsletter.subject}\\n`;\nmessage += `🕐 *Enviado:* ${new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' })}\\n\\n`;\nmessage += `💡 _Verifique sua caixa de entrada!_`;\n\nreturn [{\n  json: {\n    chat_id: sessionData.chat_id,\n    text: message,\n    parse_mode: 'Markdown',\n    newsletter_id: newsletter.id\n  }\n}];"

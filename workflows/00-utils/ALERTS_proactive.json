    },
    {
      "parameters": {
        "jsCode": "// Formatar mensagem de alerta\n\nconst data = $input.first().json;\n\nlet message = `\\u26a0\\ufe0f *ALERTA: Sistema Inativo*\\n\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\n\\n`;\nmessage += `\\u23f0 *Ultima atividade:* ${data.lastActivityFormatted}\\n`;\nmessage += `\\ud83d\\udcca *Horas sem atividade:* ${data.hoursInactive}h\\n\\n`;\n\nif (data.pendingCount > 0) {\n  message += `\\ud83d\\udcdd *Pendentes na fila:* ${data.pendingCount} artigo(s)\\n\\n`;\n}\n\nmessage += `\\ud83d\\udca1 *Sugestoes:*\\n`;\nmessage += `   \\u2022 Verificar fontes RSS\\n`;\nmessage += `   \\u2022 Adicionar noticia via /add\\n`;\nmessage += `   \\u2022 Usar /status para diagnostico\\n\\n`;\nmessage += `_Este alerta e enviado automaticamente quando o sistema fica 6h+ sem processar conteudo._`;\n\nreturn [{ json: { message, parse_mode: 'Markdown' } }];"
      },

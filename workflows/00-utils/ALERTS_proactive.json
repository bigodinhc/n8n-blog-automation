    {
      "parameters": {
        "jsCode": "// Verificar se houve atividade nas ultimas 6 horas\n\nconst items = $input.all().map(i => i.json);\nconst now = new Date();\nconst sixHoursAgo = new Date(now.getTime() - 6 * 60 * 60 * 1000);\n\nlet lastActivityDate = null;\n\nfor (const item of items) {\n  const dates = [\n    item.created_at,\n    item.updated_at,\n    item.review_started_at,\n    item.reviewed_at\n  ].filter(d => d);\n  \n  for (const dateStr of dates) {\n    const date = new Date(dateStr);\n    if (!lastActivityDate || date > lastActivityDate) {\n      lastActivityDate = date;\n    }\n  }\n}\n\nconst isInactive = !lastActivityDate || lastActivityDate < sixHoursAgo;\n\nlet hoursInactive = 0;\nif (lastActivityDate) {\n  hoursInactive = Math.round((now - lastActivityDate) / (1000 * 60 * 60));\n}\n\nconst pendingCount = items.filter(i => ['draft', 'pending_review'].includes(i.status)).length;\n\nreturn [{\n  json: {\n    isInactive,\n    hoursInactive,\n    lastActivityFormatted: lastActivityDate ? lastActivityDate.toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : 'Nunca',\n    pendingCount,\n    shouldAlert: isInactive\n  }\n}];"
      },
      "id": "check-activity",
      "name": "VERIFICAR ATIVIDADE",
      "type": "n8n-nodes-base.code",
      "position": [
        448,
        0
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict",

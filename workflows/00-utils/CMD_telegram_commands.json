      "id": "query-queue",
      "name": "QUERY FILA",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        512,
        64
      ],
      "credentials": {
        "supabaseApi": {
          "id": "04rdCJqTixOtwak5",
          "name": "blogging"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Formatar mensagem de /queue\n\nconst items = $input.all().map(i => i.json);\nconst filtered = items.filter(i => ['draft', 'pending_review', 'approved'].includes(i.status));\n\nif (filtered.length === 0) {\n  return [{ json: { message: '📭 *FILA VAZIA*\\n\\nNenhum artigo na fila de processamento.', parse_mode: 'Markdown' } }];\n}\n\nconst drafts = filtered.filter(i => i.status === 'draft');\nconst pending = filtered.filter(i => i.status === 'pending_review');\nconst approved = filtered.filter(i => i.status === 'approved');\n\nconst formatItem = (item, index) => {\n  const title = item.title ? item.title.substring(0, 40) + (item.title.length > 40 ? '...' : '') : 'Sem título';\n  return `   ${index + 1}. ${title}`;\n};\n\nlet message = '📋 *FILA DE CONTEÚDO*\\n━━━━━━━━━━━━━━━━━━━━━\\n\\n';\n\nif (drafts.length > 0) {\n  message += `📝 *Rascunhos (${drafts.length}):*\\n`;\n  message += drafts.slice(0, 5).map((d, i) => formatItem(d, i)).join('\\n');\n  if (drafts.length > 5) message += `\\n   _... e mais ${drafts.length - 5}_`;\n  message += '\\n\\n';\n}\n\nif (pending.length > 0) {\n  message += `⏳ *Em Revisão (${pending.length}):*\\n`;\n  message += pending.slice(0, 5).map((d, i) => formatItem(d, i)).join('\\n');\n  message += '\\n\\n';\n}\n\nif (approved.length > 0) {\n  message += `✅ *Aprovados (${approved.length}):*\\n`;\n  message += approved.slice(0, 5).map((d, i) => formatItem(d, i)).join('\\n');\n}\n\nreturn [{ json: { message: message.trim(), parse_mode: 'Markdown' } }];"
      },

    {
      "parameters": {
        "jsCode": "// Formatar mensagem de /status\n\nconst workflowData = $('QUERY STATUS').all().map(i => i.json);\nconst publishedData = $input.all().map(i => i.json);\n\n// Contar status dos workflows\nconst drafts = workflowData.filter(w => w.status === 'draft').length;\nconst pendingReview = workflowData.filter(w => w.status === 'pending_review').length;\nconst approved = workflowData.filter(w => w.status === 'approved').length;\nconst published = workflowData.filter(w => w.status === 'published').length;\n\n// Contar publicacoes de hoje\nconst today = new Date().toISOString().split('T')[0];\nconst wpToday = publishedData.filter(p => p.platform === 'wordpress' && p.published_at && p.published_at.startsWith(today)).length;\nconst twitterToday = publishedData.filter(p => p.platform === 'twitter' && p.published_at && p.published_at.startsWith(today)).length;\nconst linkedinToday = publishedData.filter(p => p.platform === 'linkedin' && p.published_at && p.published_at.startsWith(today)).length;\n\nconst message = `📊 *STATUS DO BLOG SYSTEM*\\n━━━━━━━━━━━━━━━━━━━━━\\n\\n📥 *Fontes de Dados:*\\n   • RSS Feeds: ✅ Ativo\\n   • Telegram Input: ✅ Ativo\\n\\n📝 *Fila de Conteúdo:*\\n   • Rascunhos: ${drafts} artigos\\n   • Em revisão: ${pendingReview} artigo(s)\\n   • Aprovados: ${approved}\\n   • Publicados: ${published}\\n\\n📤 *Publicações Hoje:*\\n   • WordPress: ${wpToday} posts\\n   • Twitter: ${twitterToday} threads\\n   • LinkedIn: ${linkedinToday} posts\\n\\n⚙️ *Comandos:*\\n/queue - Ver fila detalhada\\n/stats - Estatísticas da semana`;\n\nreturn [{ json: { message, parse_mode: 'Markdown' } }];"
      },

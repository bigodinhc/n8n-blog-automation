    {
      "parameters": {
        "jsCode": "// Formatar mensagem de /stats\n\nconst items = $input.all().map(i => i.json);\n\nconst now = new Date();\nconst weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\nconst weekItems = items.filter(i => {\n  if (!i.published_at) return false;\n  const pubDate = new Date(i.published_at);\n  return pubDate >= weekAgo;\n});\n\nconst wpCount = weekItems.filter(i => i.platform === 'wordpress').length;\nconst twitterCount = weekItems.filter(i => i.platform === 'twitter').length;\nconst linkedinCount = weekItems.filter(i => i.platform === 'linkedin').length;\nconst totalWeek = weekItems.length;\nconst totalAll = items.length;\nconst avgDaily = (totalWeek / 7).toFixed(1);\n\nconst startDate = weekAgo.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });\nconst endDate = now.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });\n\nconst message = `📈 *ESTATÍSTICAS DA SEMANA*\\n━━━━━━━━━━━━━━━━━━━━━\\n📅 Período: ${startDate} - ${endDate}\\n\\n📤 *Publicações (7 dias):*\\n   • WordPress: ${wpCount} posts\\n   • Twitter: ${twitterCount} threads\\n   • LinkedIn: ${linkedinCount} posts\\n   • *Total:* ${totalWeek}\\n\\n📊 *Métricas:*\\n   • Média diária: ${avgDaily} posts/dia\\n   • Total histórico: ${totalAll} publicações\\n\\n💡 _Use /status para ver a fila atual_`;\n\nreturn [{ json: { message, parse_mode: 'Markdown' } }];"
      },

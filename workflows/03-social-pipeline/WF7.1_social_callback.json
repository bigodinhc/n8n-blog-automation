    {
      "parameters": {
        "jsCode": "const prep = $('PREPARAR PUBLICACAO').first().json;\nconst results = $input.all();\nlet twitterResult = results.find(r => r.json.platform === 'twitter');\nlet hasSuccess = false;\nlet hasError = false;\n\n// Build visual report\nlet report = '';\nlet twitterSection = '';\nlet linkedinSection = '';\nlet instagramSection = '';\n\n// Twitter section\nif (twitterResult) {\n  const tw = twitterResult.json;\n  if (tw.skipped) {\n    twitterSection = '🐦 *Twitter:* Nao selecionado';\n  } else if (tw.success) {\n    twitterSection = '🐦 *Twitter:* ✅ Thread completa (4/4)\\n';\n    twitterSection += '🔗 ' + tw.thread_url;\n    if (tw.tweet1_has_image) twitterSection += '\\n🖼 Imagem anexada ao tweet';\n    hasSuccess = true;\n  } else if (tw.partial_success) {\n    twitterSection = '🐦 *Twitter:* ⚠️ Thread parcial (' + tw.total_published + '/4)\\n';\n    if (tw.thread_url) twitterSection += '🔗 ' + tw.thread_url;\n    hasSuccess = true;\n    hasError = true;\n  } else {\n    twitterSection = '🐦 *Twitter:* ❌ Falhou (0/4)\\n';\n    if (tw.error_summary) twitterSection += '⚠️ ' + tw.error_summary.substring(0, 100);\n    hasError = true;\n  }\n}\n\n// LinkedIn section\nif (prep.publish_linkedin) {\n  linkedinSection = '💼 *LinkedIn:* ⏳ API nao configurada';\n} else {\n  linkedinSection = '💼 *LinkedIn:* Nao selecionado';\n}\n\n// Instagram section\nif (prep.publish_instagram) {\n  instagramSection = '📸 *Instagram:* ⏳ API nao configurada';\n} else {\n  instagramSection = '📸 *Instagram:* Nao selecionado';\n}\n\n// Header based on result\nlet header;\nlet headerEmoji;\nif (hasError && !hasSuccess) {\n  header = '❌ PUBLICACAO FALHOU';\n} else if (hasError && hasSuccess) {\n  header = '⚠️ PUBLICACAO PARCIAL';\n} else if (hasSuccess) {\n  header = '✅ PUBLICACAO CONCLUIDA';\n} else {\n  header = '📊 RESULTADO';\n}\n\n// Assemble final report\nreport = header + '\\n';\nreport += '━━━━━━━━━━━━━━━━━━━━━\\n\\n';\nreport += twitterSection + '\\n\\n';\nreport += linkedinSection + '\\n\\n';\nreport += instagramSection + '\\n\\n';\nreport += '━━━━━━━━━━━━━━━━━━━━━\\n';\nreport += '📰 *Post:* ' + prep.wordpress_url;\n\nreturn { json: { report: report, message_id: prep.message_id, chat_id: prep.chat_id, session_id: prep.session_id, decision: prep.decision, has_success: hasSuccess, has_error: hasError, twitter_image_url: prep.twitter_image_url } };"
      },

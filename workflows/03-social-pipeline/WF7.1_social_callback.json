    {
      "parameters": {
        "jsCode": "function getTweetData(nodeName, tweetNumber) {\n  try {\n    const node = $items(nodeName);\n    if (!node || node.length === 0) return { number: tweetNumber, success: false, id: '', error: 'Node sem output' };\n    const item = node[0];\n    if (item.json.error) return { number: tweetNumber, success: false, id: '', error: item.json.error.message || 'Erro' };\n    const tweetId = item.json.data?.id || item.json.id || '';\n    if (tweetId) return { number: tweetNumber, success: true, id: tweetId, error: '' };\n    return { number: tweetNumber, success: false, id: '', error: 'Tweet ID nao encontrado' };\n  } catch (err) {\n    return { number: tweetNumber, success: false, id: '', error: err.message };\n  }\n}\n\nlet tweet1;\ntry {\n  const imgNode = $items('EXTRAIR ID TWEET1 IMG');\n  if (imgNode && imgNode.length > 0 && imgNode[0].json.id) {\n    tweet1 = { number: 1, success: true, id: imgNode[0].json.id, error: '', has_image: true };\n  } else {\n    tweet1 = getTweetData('TWEET 1 HOOK', 1);\n    tweet1.has_image = false;\n  }\n} catch (e) {\n  tweet1 = getTweetData('TWEET 1 HOOK', 1);\n  tweet1.has_image = false;\n}\n\nconst tweet2 = getTweetData('TWEET 2 CONTEXTO', 2);\nconst tweet3 = getTweetData('TWEET 3 BRASIL', 3);\nconst tweet4 = getTweetData('TWEET 4 CTA', 4);\nconst tweets = [tweet1, tweet2, tweet3, tweet4];\nconst totalPublished = tweets.filter(t => t.success).length;\nconst allSuccess = totalPublished === 4;\nconst partialSuccess = totalPublished > 0 && totalPublished < 4;\nconst threadUrl = tweet1.success ? 'https://x.com/MineralsTNews/status/' + tweet1.id : '';\nconst errors = tweets.filter(t => !t.success && t.error).map(t => 'Tweet ' + t.number + ': ' + t.error).join('; ');\n\nreturn { json: { platform: 'twitter', success: allSuccess, partial_success: partialSuccess, all_failed: totalPublished === 0, tweets: tweets, thread_url: threadUrl, total_published: totalPublished, total_failed: 4 - totalPublished, error_summary: errors, tweet1_has_image: tweet1.has_image || false } };"
      },

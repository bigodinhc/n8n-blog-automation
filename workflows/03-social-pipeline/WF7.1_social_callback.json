        "jsCode": "const callbackData = $json.callback_query.data;\nconst messageId = $json.callback_query.message.message_id;\nconst chatId = $json.callback_query.message.chat.id;\n\nconst parts = callbackData.split('_');\nconst decision = parts[1];\nconst sessionId = parts.slice(2).join('_');\n\nconst publish_twitter = decision === 'all' || decision === 'twitter';\nconst publish_linkedin = decision === 'all' || decision === 'linkedin';\nconst publish_instagram = decision === 'all' || decision === 'instagram';\n\nlet platforms = [];\nif (publish_twitter) platforms.push('Twitter');\nif (publish_linkedin) platforms.push('LinkedIn');\nif (publish_instagram) platforms.push('Instagram');\nconst platforms_text = platforms.length > 0 ? platforms.join('\\n') : 'Nenhuma plataforma';\n\nreturn {\n  json: {\n    callback_data: callbackData,\n    decision: decision,\n    session_id: sessionId,\n    message_id: messageId,\n    chat_id: chatId,\n    publish_twitter: publish_twitter,\n    publish_linkedin: publish_linkedin,\n    publish_instagram: publish_instagram,\n    is_cancel: decision === 'cancel',\n    platforms_text: platforms_text\n  }\n};"

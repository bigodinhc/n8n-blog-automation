        "jsCode": "const inputData = $('PREPARAR REDO').first().json;\nconst aiResponse = $json;\n\nconst imagePrompt = aiResponse.text || aiResponse.output || aiResponse.response || '';\n\nconst timestamp = Date.now();\nconst sanitizedTitle = inputData.title.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-z0-9\\s-]/g, '').replace(/\\s+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '').substring(0, 40);\n\nconst imageFilename = `twitter-${sanitizedTitle}-${timestamp}.png`;\nconst storagePath = `twitter/${inputData.post_id}/${imageFilename}`;\n\nreturn {\n  json: {\n    post_id: inputData.post_id,\n    title: inputData.title,\n    session_id: inputData.session_id,\n    message_id: inputData.message_id,\n    chat_id: inputData.chat_id,\n    twitter_image_prompt: imagePrompt,\n    twitter_image_filename: imageFilename,\n    twitter_storage_path: storagePath\n  }\n};"

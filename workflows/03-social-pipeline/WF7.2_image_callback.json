      "parameters": {
        "jsCode": "const callbackData = $json.callback_query.data;\nconst messageId = $json.callback_query.message.message_id;\nconst chatId = $json.callback_query.message.chat.id;\n\n// Formato: img_{action}_{session_id}\nconst parts = callbackData.split('_');\nconst action = parts[1]; // approve, redo, cancel\nconst sessionId = parts.slice(2).join('_');\n\nreturn {\n  json: {\n    callback_data: callbackData,\n    action: action,\n    session_id: sessionId,\n    message_id: messageId,\n    chat_id: chatId,\n    is_approve: action === 'approve',\n    is_redo: action === 'redo',\n    is_cancel: action === 'cancel'\n  }\n};"
      },

      "parameters": {
        "jsCode": "const session = $('BUSCAR SESSAO').first().json;\nconst imgData = $('EXTRAIR DADOS IMG').first().json;\n\nconst twitter = typeof session.twitter_content === 'string' ? JSON.parse(session.twitter_content) : session.twitter_content;\nconst linkedin = typeof session.linkedin_content === 'string' ? JSON.parse(session.linkedin_content) : session.linkedin_content;\nconst instagram = typeof session.instagram_content === 'string' ? JSON.parse(session.instagram_content) : session.instagram_content;\n\nconst truncate = (text, max) => text && text.length > max ? text.substring(0, max-3) + '...' : (text || '');\n\nconst preview = `\\u2705 *IMAGEM APROVADA!*\\n\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\n\\n\\ud83d\\udcf1 *PREVIEW REDES SOCIAIS*\\n\\n\\ud83d\\udcf0 *Post:* ${truncate(session.wordpress_url ? session.wordpress_url.split('/').pop() : 'Post', 60)}\\n\\ud83d\\udd17 ${session.wordpress_url}\\n\\ud83d\\uddbc Imagem: \\u2705 Aprovada\\n\\n\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\n\\ud83d\\udc26 *TWITTER/X (Thread 4 tweets):*\\n\\n1\\ufe0f\\u20e3 ${twitter.tweet1_hook}\\n\\n2\\ufe0f\\u20e3 ${twitter.tweet2_contexto}\\n\\n3\\ufe0f\\u20e3 ${twitter.tweet3_brasil}\\n\\n4\\ufe0f\\u20e3 ${twitter.tweet4_cta}\\n\\n\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\n\\ud83d\\udcbc *LINKEDIN:*\\n\\n${truncate(linkedin.post, 600)}\\n\\n\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\n\\ud83d\\udcf8 *INSTAGRAM:*\\n\\n${truncate(instagram.caption, 400)}\\n\\n\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501`;\n\nconst sessionId = session.session_id;\n\nconst replyMarkup = {\n  inline_keyboard: [\n    [{ text: '\\u2705 PUBLICAR TODAS', callback_data: `social_all_${sessionId}` }],\n    [{ text: '\\ud83d\\udc26 So Twitter', callback_data: `social_twitter_${sessionId}` }, { text: '\\ud83d\\udcbc So LinkedIn', callback_data: `social_linkedin_${sessionId}` }],\n    [{ text: '\\ud83d\\udcf8 So Instagram', callback_data: `social_instagram_${sessionId}` }, { text: '\\u274c Cancelar', callback_data: `social_cancel_${sessionId}` }]\n  ]\n};\n\nreturn {\n  json: {\n    chat_id: imgData.chat_id,\n    text: preview,\n    parse_mode: 'Markdown',\n    reply_markup: replyMarkup,\n    message_id: imgData.message_id\n  }\n};"
      },

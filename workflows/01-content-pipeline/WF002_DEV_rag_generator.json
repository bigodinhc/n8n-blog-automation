      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        720,
        -96
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Transforme os dados de mercado em uma NOTICIA.\n\n## DADOS\nTier: {{$('Prepare Data').item.json.tier}}\nTitulo: {{$('Prepare Data').item.json.original_title}}\nConteudo: {{$('Prepare Data').item.json.blob_content}}\n\n## CONTEXTO RAG\n{{ $('RAG_7 BUILD CONTEXT').item.json.rag_context }}\n\nRETORNE JSON com: title, slug, excerpt, content_html, categories, tags, structured_data",
        "options": {
          "systemMessage": "Voce e jornalista especializado em commodities. Reescreva noticias para o blog Minerals Trading Daily em portugues BR."
        }
      }
    },
    {
      "id": "process-output",
      "name": "Process AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        -96
      ],
      "parameters": {
        "jsCode": "// Processa output do AI Agent\nconst agentOutput = $input.first().json.output;\nconst intelligenceData = $('Prepare Data').first().json;\n\nfunction sanitizeJsonString(str) {\n  if (!str) return str;\n  str = str.replace(/[\\u201C\\u201D\\u201E\\u201F\\u2033\\u2036]/g, '\"')\n    .replace(/[\\u2018\\u2019\\u201A\\u201B\\u2032\\u2035]/g, \"'\")\n    .replace(/[\\u00AB\\u00BB]/g, '\"')\n    .replace(/[\\u2014\\u2013]/g, '-')\n    .replace(/\\u2026/g, '...')\n    .replace(/\\u00A0/g, ' ');\n  str = str.replace(/[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F]/g, '');\n  return str;\n}\n\nfunction extractJsonFromOutput(output) {\n  if (!output) throw new Error('Output vazio');\n  let cleaned = sanitizeJsonString(output);\n  cleaned = cleaned.replace(/^```json\\s*\\n?/gi, '').replace(/^```\\s*\\n?/gi, '').replace(/\\n?```\\s*$/gi, '').trim();\n  if (!cleaned.startsWith('{') && !cleaned.startsWith('[')) {\n    const jsonMatch = cleaned.match(/\\{[\\s\\S]*\\}/);\n    if (jsonMatch) cleaned = jsonMatch[0];\n    else throw new Error('JSON nao encontrado');\n  }\n  try { return JSON.parse(cleaned); }\n  catch (e) {\n    let fixed = cleaned.replace(/\\r\\n/g, ' ').replace(/\\n/g, ' ').replace(/\\s+/g, ' ');\n    return JSON.parse(fixed);\n  }\n}\n\nfunction generateUniqueSlug(baseText, intelligenceId) {\n  let cleanSlug = (baseText || 'post').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').substring(0, 50);\n  const now = new Date();\n  const dateStr = now.getFullYear() + String(now.getMonth() + 1).padStart(2, '0') + String(now.getDate()).padStart(2, '0');\n  const uniqueId = intelligenceId ? intelligenceId.replace(/-/g, '').slice(-6) : String(Math.floor(100000 + Math.random() * 900000));\n  return cleanSlug + '-' + dateStr + '-' + uniqueId;\n}\n\nlet blogPost;\ntry {\n  blogPost = extractJsonFromOutput(agentOutput);\n} catch (error) {\n  return { error: true, message: error.message, raw_output: agentOutput?.substring(0, 500) };\n}\n\nconst uniqueSlug = generateUniqueSlug(blogPost.slug || blogPost.title, intelligenceData.intelligence_id || intelligenceData.id);\nconst now = new Date().toISOString();\n\nconst content_post = {\n  intelligence_id: intelligenceData.intelligence_id || intelligenceData.id,\n  tier: intelligenceData.tier || 'TIER_2',\n  title: blogPost.title,\n  slug: uniqueSlug,\n  excerpt: blogPost.excerpt,\n  content_html: blogPost.content_html,\n  content_markdown: blogPost.content_markdown || '',\n  word_count: parseInt(blogPost.word_count) || 0,\n  reading_time_minutes: parseInt(blogPost.reading_time_minutes) || Math.ceil((parseInt(blogPost.word_count) || 0) / 200),\n  post_type: 'archive',\n  original_source: intelligenceData.source || 'Market Intelligence',\n  original_date: intelligenceData.created_at || None,\n  created_at: now,\n  updated_at: now\n};\n\nconst content_metadata = {\n  meta_title: blogPost.meta_title || blogPost.title,\n  meta_description: blogPost.meta_description || blogPost.excerpt,\n  categories: blogPost.categories || [],\n  tags: blogPost.tags || [],\n  structured_data: blogPost.structured_data || {}\n};\n\nreturn { content_post, content_metadata, rag_sources: blogPost.rag_sources_used || [] };"
      }
    },

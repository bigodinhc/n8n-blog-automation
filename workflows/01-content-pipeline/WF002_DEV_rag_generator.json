    {
      "id": "rag-context",
      "name": "RAG_7 BUILD CONTEXT",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        -96
      ],
      "parameters": {
        "jsCode": "// Monta contexto RAG para o AI Agent\nconst preparedData = $('Prepare Data').first().json;\nconst similarPosts = $('RAG_4 HYBRID SEARCH').all();\nconst prices = $('RAG_5 GET PRICES').all();\nconst glossary = $('RAG_6 GET GLOSSARY').all();\n\n// Posts similares\nconst postsContext = similarPosts.length > 0 \n  ? similarPosts.map((p, i) => `### Post ${i+1}\\n${p.json.chunk_text?.substring(0, 300) || 'N/A'}...`).join('\\n\\n')\n  : 'Nenhum post similar encontrado.';\n\n// Precos recentes\nconst pricesContext = prices.length > 0\n  ? prices.map(p => `${p.json.symbol}: $${p.json.price} (${p.json.assessed_date})`).join('\\n')\n  : 'Precos nao disponiveis.';\n\n// Glossario\nconst glossaryContext = glossary.length > 0\n  ? glossary.map(g => `**${g.json.term}**: ${g.json.definition}`).join('\\n')\n  : '';\n\nconst ragContext = `\n## CONTEXTO RAG\n\n### Posts Anteriores Relacionados\n${postsContext}\n\n### Precos Recentes\n${pricesContext}\n\n### Glossario\n${glossaryContext}\n`;\n\nreturn [{\n  json: {\n    ...preparedData,\n    rag_context: ragContext,\n    similar_posts_count: similarPosts.length,\n    has_price_data: prices.length > 0\n  }\n}];"
      }
    },

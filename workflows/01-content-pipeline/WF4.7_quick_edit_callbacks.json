      "parameters": {
        "jsCode": "const data = $('PROCESSAR DADOS').first().json;\nconst editType = data.edit_type;\n\nlet promptText;\nswitch(editType) {\n  case 'title':\n    promptText = '📝 *EDITAR TÍTULO*\\n\\nEnvie o novo título do post:\\n\\n_Regras: 10-120 caracteres_';\n    break;\n  case 'tags':\n    promptText = '🏷️ *EDITAR TAGS*\\n\\nEnvie as novas tags separadas por vírgula:\\n\\n_Exemplo: minério, china, vale, commodities_\\n_Regras: 1-10 tags, cada uma com 2-30 caracteres_';\n    break;\n  case 'content':\n    promptText = '📄 *EDITAR CONTEÚDO*\\n\\nDescreva as alterações que deseja no conteúdo:\\n\\n_As alterações serão processadas por AI_\\n_Regras: mínimo 20 caracteres_';\n    break;\n  default:\n    promptText = '✏️ Envie o novo valor:';\n}\n\nreturn [{\n  chat_id: data.chat_id,\n  text: promptText,\n  parse_mode: 'Markdown'\n}];"

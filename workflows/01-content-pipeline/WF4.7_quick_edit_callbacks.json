      "parameters": {
        "jsCode": "// Processar dados recebidos via executeWorkflow\nconst data = $json;\nconst callbackData = data.callback_data || '';\nconst callbackQueryId = data.callback_query_id;\nconst chatId = data.chat_id;\nconst messageId = data.message_id;\nconst userId = data.user_id;\nconst userName = data.user_name;\n\n// Parseia: qe_action_postid ou edit_postid\nconst parts = callbackData.split('_');\nlet action, postId;\n\nif (parts[0] === 'qe') {\n  action = parts[1];\n  postId = parts.slice(2).join('_');\n} else if (parts[0] === 'edit') {\n  action = 'menu';\n  postId = parts.slice(1).join('_');\n} else {\n  return [{ is_quick_edit: false }];\n}\n\nreturn [{\n  is_quick_edit: true,\n  action: action,\n  post_id: postId,\n  callback_query_id: callbackQueryId,\n  chat_id: chatId,\n  message_id: messageId,\n  user_id: userId,\n  user_name: userName,\n  is_menu: action === 'menu',\n  is_start: ['title', 'tags', 'content'].includes(action),\n  is_confirm: action === 'confirm',\n  is_redo: action === 'redo',\n  is_cancel: action === 'cancel',\n  edit_type: ['title', 'tags', 'content'].includes(action) ? action : null\n}];"
      },

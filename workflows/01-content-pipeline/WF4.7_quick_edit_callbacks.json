      "parameters": {
        "jsCode": "const session = $json;\nconst callback = $('PROCESSAR DADOS').first().json;\n\nif (!session || !session.id) {\n  return [{\n    success: false,\n    error: 'Sessao nao encontrada',\n    chat_id: callback.chat_id\n  }];\n}\n\nconst editType = session.edit_type;\nconst newValue = session.new_value;\nconst postId = session.post_id;\n\nlet updateFields = {};\nlet successMessage = '';\n\nswitch(editType) {\n  case 'title':\n    updateFields = { title: newValue };\n    successMessage = `✅ *Título atualizado!*\\n\\n📝 Novo título:\\n_${newValue}_`;\n    break;\n    \n  case 'tags':\n    const tagsArray = newValue.split(',').map(t => t.trim().toLowerCase()).filter(t => t.length > 0);\n    updateFields = { tags: tagsArray };\n    successMessage = `✅ *Tags atualizadas!*\\n\\n🏷️ Novas tags:\\n_${tagsArray.join(', ')}_`;\n    break;\n    \n  case 'content':\n    return [{\n      success: true,\n      needs_ai: true,\n      post_id: postId,\n      feedback: newValue,\n      session_id: session.session_id,\n      chat_id: callback.chat_id,\n      message: '✅ *Alterações enviadas para AI!*\\n\\n⏳ Aguarde o processamento...'\n    }];\n}\n\nreturn [{\n  success: true,\n  needs_ai: false,\n  post_id: postId,\n  edit_type: editType,\n  update_fields: updateFields,\n  session_id: session.session_id,\n  chat_id: callback.chat_id,\n  message: successMessage\n}];"
      },
